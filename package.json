{
  "name": "@hotcodepush/node",
  "description": "The typed Node client for the HotCodePush REST API",
  "version": "0.0.0",
  "private": false,
  "keywords": [
    "hotcodepush",
    "over-the-air",
    "ota",
    "react-native",
    "expo",
    "capacitor",
    "cordova",
    "api",
    "sdk"
  ],
  "homepage": "https://hotcodepush.com/docs/api/node",
  "bugs": {
    "url": "https://github.com/hotcodepush-team/hotcodepush-node/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotcodepush-team/hotcodepush-node.git"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check-openapi-drift": "node scripts/check-openapi-drift.ts",
    "fmt": "eslint --fix . && prettier --write .",
    "generate": "openapi-typescript openapi.json --output src/generated/schema.d.ts --empty-objects-unknown",
    "lint": "eslint . && prettier --check .",
    "sync-openapi": "node scripts/sync-openapi.ts",
    "test": "vitest run",
    "typecheck": "npm run generate -- --check && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "openapi-typescript": "7.13.0",
    "pkg-pr-new": "0.0.88",
    "prettier": "3.9.8",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
